NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://littlebluebook:littlebluebook-local@127.0.0.1:5432/littlebluebook
REDIS_URL=redis://127.0.0.1:6379
FRONTEND_ORIGIN=http://127.0.0.1:3000
SWAGGER_ENABLED=true
TRUST_PROXY_HOPS=0
COOKIE_SECURE=false
AUTH_CODE_HASH_SECRET=replace-with-at-least-32-random-characters
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FROM_ADDRESS=replace-with-sender@example.com
SMTP_USERNAME=replace-with-smtp-username
SMTP_AUTH_CODE=replace-with-smtp-authorization-code
SMTP_FROM_NAME=小蓝书
MAIL_TRANSPORT=smtp
MEDIA_ROOT=../.data/media
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:3001/api/v1/media
