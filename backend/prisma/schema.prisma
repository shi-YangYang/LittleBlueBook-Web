generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  PRIVATE
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  email            String   @unique @db.VarChar(320)
  nickname         String   @db.VarChar(20)
  littleBlueBookId String   @unique @db.VarChar(10)
  gender           Gender   @default(PRIVATE)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  lastLoginAt      DateTime @default(now()) @db.Timestamptz(3)
  notes            Note[]

  @@map("users")
}

model Channel {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique @db.VarChar(32)
  name         String   @db.VarChar(20)
  displayOrder Int      @unique
  enabled      Boolean  @default(true)
  publishable  Boolean  @default(true)
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  notes        Note[]

  @@index([isPublic, enabled, displayOrder])
  @@map("channels")
}

model Note {
  id              String      @id @default(uuid()) @db.Uuid
  authorId        String      @db.Uuid
  channelId       String      @db.Uuid
  title           String      @db.VarChar(50)
  content         String      @db.Text
  clientRequestId String      @db.Uuid
  createdAt       DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @db.Timestamptz(3)
  author          User        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  channel         Channel     @relation(fields: [channelId], references: [id], onDelete: Restrict)
  images          NoteImage[]

  @@unique([authorId, clientRequestId])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([channelId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("notes")
}

model NoteImage {
  id        String @id @default(uuid()) @db.Uuid
  noteId    String @db.Uuid
  objectKey String @unique @db.VarChar(64)
  mimeType  String @db.VarChar(16)
  byteSize  Int
  width     Int
  height    Int
  order     Int
  note      Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, order])
  @@map("note_images")
}
