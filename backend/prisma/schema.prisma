generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  PRIVATE
}

enum NotificationType {
  NOTE_LIKED
  NOTE_FAVORITED
  NOTE_COMMENTED
  USER_FOLLOWED
  COMMENT_REPLIED
  COMMENT_LIKED
}

enum ViewSubjectType {
  AUTHENTICATED
  ANONYMOUS
}

enum AvatarCleanupStatus {
  RESERVED
  READY
  CLEANING
}

enum LegalAcceptanceScene {
  REGISTRATION
  LOGIN
  RECONFIRMATION
}

enum NoteContentType {
  IMAGE
  VIDEO
}

enum MediaCleanupStatus {
  READY
  CLEANING
  EXHAUSTED
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ModerationStatus {
  VISIBLE
  HIDDEN
}

enum ReportTargetType {
  NOTE
  COMMENT
  USER
}

enum ReportReason {
  SEXUAL
  VIOLENCE
  HATE
  HARASSMENT
  PERSONAL_ATTACK
  SPAM
  INFRINGEMENT
  OTHER
}

enum ReportStatus {
  PENDING
  ACTIONED
  DISMISSED
  TARGET_UNAVAILABLE
}

enum ModerationAction {
  DISMISS_REPORT
  HIDE_NOTE
  RESTORE_NOTE
  HIDE_COMMENT
  RESTORE_COMMENT
  SUSPEND_USER
  RESTORE_USER
}

model User {
  id                    String               @id @default(uuid()) @db.Uuid
  email                 String               @unique @db.VarChar(320)
  nickname              String               @db.VarChar(20)
  littleBlueBookId      String               @unique @db.VarChar(10)
  gender                Gender               @default(PRIVATE)
  birthDate             DateTime?            @db.Date
  showAge               Boolean              @default(false)
  bio                   String?              @db.VarChar(100)
  avatarObjectKey       String?              @unique @db.VarChar(64)
  profileVersion        String               @default(uuid()) @db.Uuid
  ageRestrictedAt       DateTime?            @db.Timestamptz(3)
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)
  lastLoginAt           DateTime             @default(now()) @db.Timestamptz(3)
  role                  UserRole             @default(USER)
  status                UserStatus           @default(ACTIVE)
  authVersion           Int                  @default(1)
  notes                 Note[]
  noteLikes             NoteLike[]
  noteFavorites         NoteFavorite[]
  comments              NoteComment[]
  commentLikes          CommentLike[]
  replyTargets          NoteComment[]        @relation("ReplyTargetAuthor")
  following             UserFollow[]         @relation("UserFollowing")
  followers             UserFollow[]         @relation("UserFollowers")
  receivedNotifications Notification[]       @relation("NotificationRecipient")
  actedNotifications    Notification[]       @relation("NotificationActor")
  avatarCleanupRecords  AvatarCleanup[]
  conversationsAsFirst  DirectConversation[] @relation("ConversationFirstParticipant")
  conversationsAsSecond DirectConversation[] @relation("ConversationSecondParticipant")
  sentDirectMessages    DirectMessage[]
  legalAcceptances      LegalAcceptance[]
  blocksCreated         UserBlock[]          @relation("Blocker")
  blocksReceived        UserBlock[]          @relation("Blocked")
  reportsCreated        Report[]             @relation("ReportReporter")
  moderationAudits      ModerationAudit[]    @relation("ModerationAdministrator")

  @@map("users")
}

model LegalAcceptance {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @db.Uuid
  termsVersion   String               @db.VarChar(64)
  privacyVersion String               @db.VarChar(64)
  scene          LegalAcceptanceScene
  evidenceKey    String               @unique @db.VarChar(160)
  acceptedAt     DateTime             @default(now()) @db.Timestamptz(3)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, termsVersion, privacyVersion, scene])
  @@index([userId, termsVersion, privacyVersion])
  @@index([userId, acceptedAt(sort: Desc)])
  @@map("legal_acceptances")
}

model AvatarCleanup {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @db.Uuid
  objectKey     String              @unique @db.VarChar(64)
  status        AvatarCleanupStatus
  leaseToken    String?             @db.Uuid
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now()) @db.Timestamptz(3)
  lastErrorCode String?             @db.VarChar(64)
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("avatar_cleanup")
}

model Channel {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique @db.VarChar(32)
  name         String   @db.VarChar(20)
  displayOrder Int      @unique
  enabled      Boolean  @default(true)
  publishable  Boolean  @default(true)
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  notes        Note[]

  @@index([isPublic, enabled, displayOrder])
  @@map("channels")
}

model Note {
  id              String            @id @default(uuid()) @db.Uuid
  authorId        String            @db.Uuid
  channelId       String            @db.Uuid
  title           String            @db.VarChar(50)
  content         String            @db.Text
  clientRequestId String            @db.Uuid
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  viewCount       Int               @default(0)
  contentType     NoteContentType   @default(IMAGE)
  contentVersion  Int               @default(1)
  editedAt        DateTime?         @db.Timestamptz(3)
  moderationStatus ModerationStatus @default(VISIBLE)
  author          User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  channel         Channel           @relation(fields: [channelId], references: [id], onDelete: Restrict)
  images          NoteImage[]
  video           NoteVideo?
  likes           NoteLike[]
  favorites       NoteFavorite[]
  comments        NoteComment[]
  notifications   Notification[]
  viewSubjects    NoteViewSubject[]

  @@unique([authorId, clientRequestId])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([channelId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([contentType, createdAt(sort: Desc), id(sort: Desc)])
  @@index([channelId, contentType, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId, contentType, createdAt(sort: Desc), id(sort: Desc)])
  @@map("notes")
}

model MediaCleanup {
  id            String             @id @default(uuid()) @db.Uuid
  objectKey     String             @unique @db.VarChar(64)
  status        MediaCleanupStatus @default(READY)
  leaseToken    String?            @db.Uuid
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now()) @db.Timestamptz(3)
  lastErrorCode String?            @db.VarChar(64)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("media_cleanup")
}

model NoteLike {
  userId    String   @db.Uuid
  noteId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([userId, noteId])
  @@index([noteId])
  @@index([userId, createdAt(sort: Desc), noteId(sort: Desc)])
  @@map("note_likes")
}

model NoteFavorite {
  userId    String   @db.Uuid
  noteId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([userId, noteId])
  @@index([noteId])
  @@index([userId, createdAt(sort: Desc), noteId(sort: Desc)])
  @@map("note_favorites")
}

model NoteComment {
  id              String         @id @default(uuid()) @db.Uuid
  noteId          String         @db.Uuid
  authorId        String         @db.Uuid
  rootCommentId   String?        @db.Uuid
  replyToId       String?        @db.Uuid
  replyToAuthorId String?        @db.Uuid
  content         String         @db.VarChar(500)
  deletedAt       DateTime?      @db.Timestamptz(3)
  moderationStatus ModerationStatus @default(VISIBLE)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  note            Note           @relation(fields: [noteId], references: [id], onDelete: Cascade)
  author          User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  rootComment     NoteComment?   @relation("CommentRoot", fields: [rootCommentId], references: [id], onDelete: Restrict)
  replies         NoteComment[]  @relation("CommentRoot")
  replyTo         NoteComment?   @relation("CommentTarget", fields: [replyToId], references: [id], onDelete: Restrict)
  referencedBy    NoteComment[]  @relation("CommentTarget")
  replyToAuthor   User?          @relation("ReplyTargetAuthor", fields: [replyToAuthorId], references: [id], onDelete: Cascade)
  likes           CommentLike[]
  notifications   Notification[]

  @@index([noteId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([rootCommentId, createdAt(sort: Asc), id(sort: Asc)])
  @@index([replyToId])
  @@index([authorId])
  @@map("note_comments")
}

model CommentLike {
  userId    String      @db.Uuid
  commentId String      @db.Uuid
  createdAt DateTime    @default(now()) @db.Timestamptz(3)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   NoteComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([commentId])
  @@index([userId, createdAt(sort: Desc), commentId(sort: Desc)])
  @@map("comment_likes")
}

model NoteViewSubject {
  noteId       String          @db.Uuid
  subjectType  ViewSubjectType
  subjectHash  String          @db.VarChar(64)
  lastViewedAt DateTime        @db.Timestamptz(3)
  note         Note            @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([noteId, subjectType, subjectHash])
  @@index([lastViewedAt])
  @@map("note_view_subjects")
}

model UserFollow {
  followerId String   @db.Uuid
  followedId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  follower   User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followed   User     @relation("UserFollowers", fields: [followedId], references: [id], onDelete: Cascade)

  @@id([followerId, followedId])
  @@index([followedId])
  @@index([followerId, createdAt(sort: Desc), followedId(sort: Desc)])
  @@map("user_follows")
}

model NoteImage {
  id        String @id @default(uuid()) @db.Uuid
  noteId    String @db.Uuid
  objectKey String @unique @db.VarChar(64)
  mimeType  String @db.VarChar(16)
  byteSize  Int
  width     Int
  height    Int
  order     Int
  note      Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, order])
  @@map("note_images")
}

model NoteVideo {
  id             String   @id @default(uuid()) @db.Uuid
  noteId         String   @unique @db.Uuid
  videoObjectKey String   @unique @db.VarChar(64)
  videoMimeType  String   @db.VarChar(32)
  videoByteSize  Int
  width          Int
  height         Int
  durationMs     Int
  videoCodec     String   @db.VarChar(16)
  audioCodec     String?  @db.VarChar(16)
  coverObjectKey String   @unique @db.VarChar(64)
  coverMimeType  String   @db.VarChar(16)
  coverByteSize  Int
  coverWidth     Int
  coverHeight    Int
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  note           Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("note_videos")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  type        NotificationType
  recipientId String           @db.Uuid
  actorId     String?          @db.Uuid
  noteId      String?          @db.Uuid
  commentId   String?          @db.Uuid
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  readAt      DateTime?        @db.Timestamptz(3)
  suppressedAt DateTime?       @db.Timestamptz(3)
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  note        Note?            @relation(fields: [noteId], references: [id], onDelete: SetNull)
  comment     NoteComment?     @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([recipientId, type, createdAt(sort: Desc), id(sort: Desc)])
  @@index([recipientId, readAt])
  @@index([recipientId, suppressedAt, createdAt(sort: Desc), id(sort: Desc)])
  @@map("notifications")
}

model UserBlock {
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockerId, createdAt(sort: Desc), blockedId(sort: Desc)])
  @@index([blockedId, blockerId])
  @@map("user_blocks")
}

model Report {
  id         String           @id @default(uuid()) @db.Uuid
  reporterId String           @db.Uuid
  targetType ReportTargetType
  targetId   String           @db.Uuid
  reason     ReportReason
  details    String?          @db.VarChar(200)
  status     ReportStatus     @default(PENDING)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)
  reporter   User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)

  @@index([reporterId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, targetType, createdAt(sort: Desc), id(sort: Desc)])
  @@index([targetType, targetId, status])
  @@map("reports")
}

model ModerationAudit {
  id              String           @id @default(uuid()) @db.Uuid
  administratorId String           @db.Uuid
  action          ModerationAction
  targetType      ReportTargetType
  targetId        String           @db.Uuid
  reason          String           @db.VarChar(500)
  previousState   String           @db.VarChar(64)
  nextState       String           @db.VarChar(64)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  administrator   User             @relation("ModerationAdministrator", fields: [administratorId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([administratorId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("moderation_audits")
}

model DirectConversation {
  id                             String          @id @default(uuid()) @db.Uuid
  firstParticipantId             String          @db.Uuid
  secondParticipantId            String          @db.Uuid
  firstParticipantReadMessageId  String?         @db.Uuid
  firstParticipantReadAt         DateTime?       @db.Timestamptz(3)
  secondParticipantReadMessageId String?         @db.Uuid
  secondParticipantReadAt        DateTime?       @db.Timestamptz(3)
  lastMessageAt                  DateTime        @db.Timestamptz(3)
  createdAt                      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime        @updatedAt @db.Timestamptz(3)
  firstParticipant               User            @relation("ConversationFirstParticipant", fields: [firstParticipantId], references: [id], onDelete: Restrict)
  secondParticipant              User            @relation("ConversationSecondParticipant", fields: [secondParticipantId], references: [id], onDelete: Restrict)
  messages                       DirectMessage[]

  @@unique([firstParticipantId, secondParticipantId])
  @@index([firstParticipantId, lastMessageAt(sort: Desc), id(sort: Desc)])
  @@index([secondParticipantId, lastMessageAt(sort: Desc), id(sort: Desc)])
  @@map("direct_conversations")
}

model DirectMessage {
  id              String             @id @default(uuid()) @db.Uuid
  conversationId  String             @db.Uuid
  senderId        String             @db.Uuid
  content         String             @db.VarChar(1000)
  clientRequestId String             @db.VarChar(100)
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  conversation    DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender          User               @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@unique([senderId, clientRequestId])
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("direct_messages")
}
